# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

PORT=3000
DB_PATH=./data/bot.db
REGIONS_PATH=./config/regions.json

# 允許使用私訊功能的 LINE userId（逗號分隔）。留空 = 任何加好友的人都能讀群組內容（不建議）
ALLOWED_USER_IDS=

# 拉取最近幾則對話
RECENT_LIMIT=10
# 單子判斷：以這些開頭的一定算單
ORDER_PATTERN=^(#單|【單】|派單|訂單|接單)|單號
# 規則打分門檻（電話+2、時間/日期/地點/金額/任務/車 各+1），越低越容易被當成單
ORDER_SCORE_THRESHOLD=3
# 選填：填了就改用 Claude 判斷單子並產生一行摘要（只有疑似單子的訊息才會送去判斷）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 新使用者預設是否即時轉發該區新訊息到私訊（每則會消耗推播額度）
LIVE_FORWARD_DEFAULT=on
DISPLAY_TZ=Asia/Taipei
# 只顯示幾小時內的單
ORDER_MAX_AGE_HOURS=6
